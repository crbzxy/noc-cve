{
  "sources": [
    {
      "id": "nvd",
      "label": "NVD (NIST)",
      "enabled": true,
      "role": "list",
      "proxyPrefix": "/api/nvd",
      "baseUrl": "https://services.nvd.nist.gov",
      "path": "/rest/json/cves/2.0",
      "authEnv": "NVD_API_KEY"
    },
    {
      "id": "github",
      "label": "GitHub Advisories",
      "enabled": true,
      "role": "list",
      "proxyPrefix": "/api/github",
      "baseUrl": "https://api.github.com",
      "path": "/advisories",
      "authEnv": "GITHUB_TOKEN"
    },
    {
      "id": "kev",
      "label": "CISA KEV",
      "enabled": true,
      "role": "enrich",
      "proxyPrefix": "/api/kev",
      "baseUrl": "https://www.cisa.gov",
      "path": "/sites/default/files/feeds/known_exploited_vulnerabilities.json"
    },
    {
      "id": "epss",
      "label": "FIRST EPSS",
      "enabled": true,
      "role": "score",
      "proxyPrefix": "/api/epss",
