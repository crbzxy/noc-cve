# Acceso al dashboard (vista privada). Por defecto: adminTel / Trup3r*2027.!
DASHBOARD_USER=adminTel
DASHBOARD_PASS=Trup3r*2027.!

# Opcionales, solo del lado servidor (proxy). Sin ellas funciona con rate limits bajos.
# NVD: https://nvd.nist.gov/developers/request-an-api-key  (50 req/30 s con key vs 5 sin key)
NVD_API_KEY=
# GitHub: token clásico o fine-grained sin scopes (5000 req/h vs 60 sin token)
GITHUB_TOKEN=
# VulnCheck KEV (community): https://docs.vulncheck.com/getting-started/api-tokens
VULNCHECK_TOKEN=
# Wordfence Intelligence v3: Account → Integrations → API key
WORDFENCE_API_KEY=
PORT=8080
# HTTPS: npm run tls:init crea certs/*.pem, o apunta a PEM corporativos:
# TLS_CERT=/ruta/cert.pem
# TLS_KEY=/ruta/key.pem
# HTTP_REDIRECT_PORT=8080
# ALLOW_HTTP=1   # solo emergencia local; en QA no usar

# QA detrás de proxy SSL inspection (self-signed in certificate chain):
# UPSTREAM_TLS_INSECURE=1
# NODE_TLS_REJECT_UNAUTHORIZED=0

# Dominios que FortiGuard debe permitir (Web Filter) para el dashboard:
# - api.osv.dev
# - api.first.org
# - services.nvd.nist.gov
# - api.github.com
# - www.cve.org
# - www.cisa.gov
# - euvdservices.enisa.europa.eu
# - api.vulncheck.com
# - www.wordfence.com
# - repo1.maven.org / registry.npmjs.org / pypi.org / proxy.golang.org
