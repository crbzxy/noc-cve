# Acceso al dashboard (vista privada). Por defecto: adminTel / Trup3r*2027.!
DASHBOARD_USER=adminTel
DASHBOARD_PASS=Trup3r*2027.!
# Firma JWT de sesión (opcional; por defecto deriva de user+pass)
# SESSION_SECRET=

# Opcionales, solo del lado servidor (proxy). Sin ellas funciona con rate limits bajos.
# NVD: https://nvd.nist.gov/developers/request-an-api-key  (50 req/30 s con key vs 5 sin key)
NVD_API_KEY=
# GitHub: token clásico o fine-grained sin scopes (5000 req/h vs 60 sin token)
GITHUB_TOKEN=
# VulnCheck KEV (community): https://docs.vulncheck.com/getting-started/api-tokens
VULNCHECK_TOKEN=
# Wordfence Intelligence v3: Account → Integrations → API key
WORDFENCE_API_KEY=
# Next escucha 3000 en el contenedor; Compose publica 8082:3000
PORT=3000

# Si Node/Docker reporta "self-signed certificate in certificate chain" / SELF_SIGNED_CERT_IN_CHAIN:
# no es un bug del dashboard — Forti (u otro proxy) sigue haciendo SSL Inspection.
# Opciones válidas (elige una; no uses -k / UPSTREAM_TLS_INSECURE en QA):
# 1) Seguridad excluye el host de SSL Inspection (no solo Web Filter allow).
# 2) Confiar el CA corporativo en el contenedor:
#    - Guarda el PEM del Forti/CA en certs/corp-ca.pem
#    - Descomenta:
# NODE_EXTRA_CA_CERTS=/app/certs/corp-ca.pem

# Dominios FortiGuard: ver README sección "Egress / FortiGuard"
# (+ vulnerability.circl.lu, access.redhat.com)
