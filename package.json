{
  "name": "noc-cve-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync:sources": "node scripts/sync-sources-config.mjs",
    "catalog:apply": "node scripts/apply-sources-catalog.mjs && node scripts/sync-sources-config.mjs",
    "predev": "node scripts/sync-sources-config.mjs && node scripts/bundle-corpus.mjs",
    "prebuild": "node scripts/sync-sources-config.mjs && node scripts/bundle-corpus.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "bundle:corpus": "node scripts/bundle-corpus.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "tls:init": "node scripts/ensure-tls-certs.mjs",
    "prestart": "node scripts/ensure-tls-certs.mjs && node scripts/bundle-corpus.mjs",
    "start": "node server/index.mjs",
    "mock": "node scripts/mock-upstream.mjs",
    "dev:mock": "MOCK_UPSTREAM=http://localhost:4010 vite",
    "start:mock": "ALLOW_HTTP=1 MOCK_UPSTREAM=http://localhost:4010 node server/index.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@tanstack/react-query": "^5.106.1",
    "date-fns": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxc-transform-react": "^0.156.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
