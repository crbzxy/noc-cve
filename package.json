{
  "name": "noc-cve-dashboard",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "sync:sources": "node scripts/sync-sources-config.mjs",
    "catalog:apply": "node scripts/apply-sources-catalog.mjs && node scripts/sync-sources-config.mjs",
    "bundle:corpus": "node scripts/bundle-corpus.mjs",
    "dev": "node scripts/docker-up.mjs",
    "dev:next": "node scripts/sync-sources-config.mjs && node scripts/bundle-corpus.mjs && next dev -H 0.0.0.0 -p 3000",
    "deploy": "node scripts/docker-up.mjs --detach",
    "prebuild": "node scripts/sync-sources-config.mjs && node scripts/bundle-corpus.mjs",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "oxlint",
    "tls:init": "node scripts/ensure-tls-certs.mjs",
    "mock": "node scripts/mock-upstream.mjs"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^7.3.5",
    "@tanstack/react-query": "^5.106.1",
    "date-fns": "^4.4.0",
    "jose": "^6.1.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.90.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.6"
  }
}
